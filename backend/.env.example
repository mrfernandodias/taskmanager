# Server Configuration
PORT=8000
NODE_ENV=development

# Database
# MongoDB connection string
# Local: mongodb://localhost:27017/taskmanager
# Cloud: mongodb+srv://username:password@cluster.mongodb.net/taskmanager
MONGODB_URI=mongodb://localhost:27017/taskmanager

# JWT (JSON Web Token) Configuration
# Generate a secure secret key: openssl rand -base64 32
JWT_SECRET=your_super_secure_jwt_secret_key_here_minimum_32_characters
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_key_here_minimum_32_characters
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# CORS Configuration
# Frontend URL for CORS policy
# Development: http://localhost:5173
# Production: https://yourdomain.com
CLIENT_URL=http://localhost:5173

# Admin Invite Token
# Token required to create admin users during registration
# Generate a random token: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_INVITE_TOKEN=your_secure_admin_invite_token_here

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
